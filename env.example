# Public site URL used for canonical links and sitemap generation
VITE_SITE_URL=https://pcsuk.co.uk

# Quote / contact enquiry delivery (Formspree)
# Without this, the UI shows an honest copyable summary fallback — it will not fake success.
VITE_FORMSPREE_QUOTES_ENDPOINT=https://formspree.io/f/your_form_id

# Reply / fallback email shown in manual send flows
VITE_ENQUIRY_EMAIL=Office@pcsuk.co.uk

# Optional EmailJS (unused by default for PCS UK quote flow)
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID_QUOTE=
# VITE_EMAILJS_PUBLIC_KEY=
